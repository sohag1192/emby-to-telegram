# ==========================================================
# Emby to Telegram Notifier - Environment Variables Template
# Copy this file to .env and adjust the values as needed
# ==========================================================

# Telegram Bot API Token from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_TOKEN=7575077293:AAF2RWn_WUMIf3LJ04RZLTOGPXsUh_B1oIE

# Telegram Chat/Channel/Group ID
# For private chat: 1065232529 | For channel/supergroup: -100xxxxxxxxxx
TELEGRAM_CHAT_ID=1065232529

# Emby Media Server Base URL (IP or domain with port)
# Example: http://192.168.1.100:8096 or https://emby.yourdomain.com
EMBY_SERVER=http://100.100.100.6:8096

# Emby API Key (Generated from Emby Dashboard > Advanced > API Keys)
EMBY_API_KEY=29db6b6f6fff4702b84543d391334e07

# Custom button text on the notification card
BUTTON_TEXT=Watch on SN FTP SERVER

# Timezone offset from UTC in hours (Default: 6 for Bangladesh Standard Time / BST)
TIMEZONE_OFFSET=6

# Interval between library checks in seconds (Default: 1800 = 30 minutes)
CHECK_INTERVAL=1800

# Delay between consecutive messages in seconds (Default: 10)
MESSAGE_DELAY=10
