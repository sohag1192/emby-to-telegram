# ==========================================================
# Emby to Telegram Notifier - Environment Variables Template
# Copy this file to .env and replace the values with your credentials
# ==========================================================

# Telegram Bot API Token from @BotFather
TELEGRAM_TOKEN=ADD YOUR TELEGRAM_TOKEN

# Telegram Chat/Channel/Group ID (use negative ID for groups/channels e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=ADD YOUR TELEGRAM_CHAT_ID

# Emby Media Server Base URL
EMBY_SERVER=http://192.168.1.100:8096

# Emby API Key (Emby Dashboard > Advanced > API Keys)
EMBY_API_KEY=ADD YOUR EMBY_API_KEY

# Custom button text on the notification card
BUTTON_TEXT=Watch on SN FTP SERVER

# Interval between library checks in seconds (Default: 1800 = 30 minutes)
CHECK_INTERVAL=1800

# Delay between consecutive messages in seconds (Default: 10)
MESSAGE_DELAY=10
